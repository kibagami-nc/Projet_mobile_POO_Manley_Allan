<?xml version="1.0" encoding="utf-8"?>
<!--
  Depuis Android 9, le HTTP en clair est interdit par defaut.
  L'API Spring Boot de developpement tourne en http:// : on l'autorise
  uniquement pour les adresses locales, jamais pour tout le reseau.

  Test sur un telephone physique : ajouter l'IP du PC, par exemple
  <domain includeSubdomains="false">192.168.1.20</domain>
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Machine hote vue depuis l'emulateur Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
